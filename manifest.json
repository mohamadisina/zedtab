{
  "manifest_version": 3,
  "name": "zed-tab",
  "version": "1.0",
  "description": "awesome new tab page..",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "permissions": [
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://suggestqueries.google.com/*"
  ],
  "icons": {
    "128": "zed-tab.png"
  }
}
